# ==============================================================================
# 🇬🇧 ENGLISH CONVERSATIONAL TUTOR - CONFIGURAÇÃO DE AMBIENTE
# ==============================================================================

# Chave de API da Google Gemini (obtenha em https://aistudio.google.com/)
GEMINI_API_KEY=

# Modelo da IA (padrão: gemini-3.5-flash-lite para máxima cota e velocidade)
GEMINI_MODEL=gemini-3.5-flash-lite

# SEGURANÇA DE CONVERSA:
# Quando true (padrão recomendado): o bot atua estritamente na sua conversa com ele mesmo ("Você / Mensagens Salvas").
# Ele NUNCA responde a conversas de amigos, contatos ou grupos.
SELF_CHAT_ONLY=true

# Lista de números adicionais autorizados caso você queira liberar o bot para outros contatos (separados por vírgula):
# Exemplo: ALLOWED_NUMBERS=5511999998888,5586999997777
ALLOWED_NUMBERS=

# Resposta em áudio quando você mandar áudio (true/false)
VOICE_REPLY_ENABLED=true

# Voz padrão da IA (opções: en-US-JennyNeural, en-US-GuyNeural, en-US-AriaNeural, en-GB-SoniaNeural)
VOICE_NAME=en-US-JennyNeural
