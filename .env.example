# Chave de API do Google Gemini (obtenha em https://aistudio.google.com/)
GEMINI_API_KEY=

# Prefixo opcional ou número de telefone autorizado (deixe vazio para responder a você mesmo ou a quem mandar mensagem)
# ALLOWED_NUMBERS=5511999999999

# Se true, além do texto, gera áudio de resposta
VOICE_REPLY_ENABLED=true

# Voz padrão em inglês (ex: en-US-JennyNeural, en-US-GuyNeural, en-GB-SoniaNeural)
VOICE_NAME=en-US-JennyNeural
